# Copy to .env and fill in.  .env is gitignored.

# --- LLM (OpenAI SDK; any OpenAI-compatible endpoint works) ---------------
OPENAI_API_KEY=sk-your-key-here

# Optional. Leave unset for api.openai.com. Examples of compatible endpoints:
#   NVIDIA build  : https://integrate.api.nvidia.com/v1
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Together      : https://api.together.xyz/v1
#   local vLLM    : http://localhost:8000/v1
# OPENAI_BASE_URL=

# Model names are configurable. Defaults below are the OpenAI hosted models.
GEN_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# The committed results in results/ were produced with:
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   GEN_MODEL=openai/gpt-oss-20b
#   JUDGE_MODEL=openai/gpt-oss-20b
# Prefer a DIFFERENT model for JUDGE_MODEL than GEN_MODEL where you can - see
# README section 13 on self-preference bias.

# Per-request timeout in seconds. The OpenAI SDK default is 600, which is long
# enough for one stalled request to hold up a whole evaluation run.
LLM_TIMEOUT_SECONDS=90

# --- Local semantic scorer (Signal A) ------------------------------------
# SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Data ----------------------------------------------------------------
# HIVER_DATA_DIR=./data
